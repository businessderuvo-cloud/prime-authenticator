{
  "expo": {
    "name": "PRIME",
    "slug": "prime-mobile",
    "version": "0.2.13",
    "orientation": "default",
    "scheme": "prime",
    "icon": "./assets/prime-icon.png",
    "backgroundColor": "#050505",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "it.primegestionale.mobile",
      "buildNumber": "15",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "PRIME usa il microfono quando avvii una conversazione vocale con Vanessa.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "it.primegestionale.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "versionCode": 15
    },
    "plugins": [
      "expo-secure-store",
      "expo-iap",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/prime-splash.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#050505",
            "image": "./assets/prime-splash.png"
          }
        }
      ],
      "./plugins/withPrimeIcon.js",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-local-authentication",
      "./plugins/withVoiceBackground.js",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "androidForegroundService": false
        }
      ]
    ]
  }
}
