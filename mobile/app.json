{
  "expo": {
    "name": "PRIME",
    "slug": "prime-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "prime",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "it.primegestionale.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "it.primegestionale.mobile",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-iap",
      "expo-router"
    ]
  }
}
