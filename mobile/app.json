{
  "expo": {
    "name": "PRIME",
    "slug": "prime-mobile",
    "version": "0.2.3",
    "orientation": "default",
    "scheme": "prime",
    "icon": "./assets/prime-icon.png",
    "backgroundColor": "#050505",
    "userInterfaceStyle": "dark",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "it.primegestionale.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "it.primegestionale.mobile",
      "permissions": [],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "versionCode": 5
    },
    "plugins": [
      "expo-secure-store",
      "expo-iap",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/prime-splash.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#050505",
            "image": "./assets/prime-splash.png"
          }
        }
      ],
      "./plugins/withPrimeIcon.js"
    ]
  }
}
